# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Django
*.log
local_settings.py
db.sqlite3

# Media files (uploads) - preserve .gitkeep
media/*
!media/.gitkeep
!media/branding/
media/branding/*
!media/branding/.gitkeep

# Environment variables
.env
.env.local

# Coverage
htmlcov/
.coverage
.coverage.*

# Distribution
dist/
build/
*.egg-info/

# Staticfiles collected
staticfiles/

# Logs
logs/*
!logs/.gitkeep

# Backups
backups/
*.sql
*.dump

# OS files
.DS_Store
Thumbs.db

# Temporary documentation
*.md.backup
*.md.old
TEMP_*.md

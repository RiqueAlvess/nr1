# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nr1_db

# Email (Resend API)
# Obtenha sua API key em: https://resend.com/api-keys
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
# API_RESEND é mantido para compatibilidade (será igual a RESEND_API_KEY)
API_RESEND=re_your_resend_api_key_here

# Magic Links
MAGIC_LINK_EXPIRATION_HOURS=48

# K-Anonymity
MIN_GROUP_SIZE=5

# Sistema
SYSTEM_NAME=Vivamente360
COMPANY_NAME=Your Company Name

# Security - SSL (Produção)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000

# Redis - Cache e Celery
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Celery - Rate Limiting
# Rate limit para envio de e-mails (formato: quantidade/período)
# Exemplos: 100/h (100 por hora), 10/m (10 por minuto), 1000/d (1000 por dia)
SEND_RATE_LIMIT=100/h

# LGPD - Retenção de Dados
DATA_RETENTION_YEARS=5

# LGPD - Criptografia de Campos Sensíveis
# IMPORTANTE: Gerar uma chave diferente do SECRET_KEY
# Para gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-field-encryption-key-here
